# =============================================================================
# config/evaluation.env.example — profile CHẠY BENCHMARK
#
# Cho `src/assessment/evaluation.py` (mặc định benchmark v2, 100 câu) và các lượt A/B
# của `src/assessment/analyze_ab.py`. Khác profile runtime ở:
#   1. GEMINI_JUDGE_MODEL tách khỏi GEMINI_MODEL để hai tầng không giành quota
#      (free tier giới hạn theo TỪNG model: ~5 request/phút, ~20/ngày).
#   2. USE_QWEN_GENERATOR=0 — chạy Gemini; dùng cờ --use-qwen-generator của runner
#      nếu muốn lượt offline (khi đó áp thêm profile offline).
#
# Lưu ý: runner tự tắt QWEN_FALLBACK khi chạy chế độ Gemini (fallback sẽ làm nhiễu
# Citation/Faithfulness), nên không cần khai báo lại ở đây.
# Cờ thí nghiệm vẫn GHIM TẮT — lượt A/B hợp lệ là lượt chỉ đổi MỘT biến đã đăng ký.
# =============================================================================

# --- Sinh câu trả lời + giám khảo ---
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
GEMINI_JUDGE_MODEL=gemini-3.5-flash-lite
GEMINI_TEMPERATURE=0.0
GEMINI_MAX_TOKENS=4096
GENERATION_CACHE=1
USE_QWEN_GENERATOR=0

# --- Truy xuất (top_k của runner có cờ --top-k riêng, mặc định 6) ---
ENABLE_HYBRID_SEARCH=1
BM25_WEIGHT=0.5
CHROMA_WEIGHT=0.5
ENABLE_QUERY_EXPANSION=1
RAG_TOP_K=6

# --- Phân loại câu hỏi: chỉ bật cho lượt A/B có --with-classifier ---
ENABLE_CLASSIFIER=0

# --- Vector DB / embedding ---
EMBEDDING_MODEL=BAAI/bge-m3
CHROMA_PERSIST_DIR=./chroma_db

# --- Cờ thí nghiệm: GHIM TẮT ---
ENABLE_ANSWER_GUARD=0
ENABLE_DECOUPLED_REFUSAL=0
ENABLE_EVIDENCE_SELECTION=0
ENABLE_RERANKER=0
RERANKER_KEEP_CANDIDATES=0
RERANKER_FALLBACK=0
ENABLE_CONTEXTUAL_HEADER=0
ENABLE_ANSWER_RESCUE=0
NORMALIZE_SANITY_GUARD=0
ROUTER_SOFT_FILTER=0
ENABLE_DENSE_ORIGINAL_QUERY=0
