# =============================================================================
# config/experiment.env.example — profile THÍ NGHIỆM (bật đúng MỘT lever)
#
# LUẬT (không thương lượng):
#   1. Round phải được ĐĂNG KÝ TRƯỚC trong data/loop/README.md (giả thuyết, tiêu chí
#      ĐẠT, ngưỡng) rồi mới chạy. Không đăng ký = không có round hợp lệ.
#   2. Mỗi round chỉ đổi MỘT biến so với nền đã chốt.
#   3. Mọi cờ dưới đây đang là DÒNG CHÚ THÍCH (`# TEN=1`). Bỏ `#` để bật — đó là
#      hành động có chủ đích của người chạy round, không phải mặc định của repo.
#      Chép nguyên tệp này mà không bỏ `#` thì KHÔNG bật gì.
#   4. Sau round: ghi kết quả vào docs/EXPERIMENTS.md + docs/DECISION_LOG.md; cờ
#      không được chứng minh thì trả về 0.
#
# Các giá trị dưới đây lấy từ lần đăng ký gần nhất của từng lever; ngưỡng đã đăng ký
# trước thì KHÔNG được chỉnh sau khi thấy kết quả.
# =============================================================================

# --- Nền runtime (giữ như runtime.env.example) ---
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5:1.5b-instruct
OLLAMA_TIMEOUT=90
USE_QWEN_GENERATOR=0
ENABLE_HYBRID_SEARCH=1
BM25_WEIGHT=0.5
CHROMA_WEIGHT=0.5
ENABLE_QUERY_EXPANSION=1
RAG_TOP_K=6
EMBEDDING_MODEL=BAAI/bge-m3
CHROMA_PERSIST_DIR=./chroma_db

# --- T3: từ chối tách đôi (r8 — KHÔNG ĐẠT, giữ tắt) ---
# ENABLE_DECOUPLED_REFUSAL=1
# DEC_MIN_ENTITY_COVERAGE=0.6
# DEC_MIN_TOKEN_OVERLAP=0.35
# DEC_MIN_RRF_NORM=0.5
# DEC_MIN_GROUNDING=0.6
# DEC_MAX_UNSUPPORTED=0.35

# --- T3: chọn câu căn cứ (r9 — KHÔNG ĐẠT, giữ tắt) ---
# ENABLE_EVIDENCE_SELECTION=1
# EV_MIN_KEYWORD_HITS=1
# EV_MIN_SENTENCES=2
# EV_MAX_SENTENCES=5
# EVIDENCE_RERANKER=      # trống = heuristic; đặt tên model nếu muốn rerank

# --- T3: guardrail sau sinh (r6/r7 — có lợi trên bộ đo hẹp nhưng chưa thành mặc định) ---
# ENABLE_ANSWER_GUARD=1

# --- T5a: reranker cross-encoder (r12/r22 — ÂM / BỊ BÁC VETO HUMAN, giữ tắt) ---
# ENABLE_RERANKER=1
# RERANKER_MODEL=BAAI/bge-reranker-v2-m3
# RERANKER_CANDIDATE_POOL=20
# RERANKER_KEEP_CANDIDATES=0
# RERANKER_FALLBACK=0
# RERANKER_MAX_LENGTH=512
# RERANKER_BATCH_SIZE=8
# RERANKER_DEVICE=cpu

# --- T5b: header ngữ cảnh (r13 — không tín hiệu, giữ tắt) ---
# ENABLE_CONTEXTUAL_HEADER=1

# --- rescue / chuẩn hoá / router / dense-raw ---
# ENABLE_ANSWER_RESCUE=1
# RESCUE_MIN_SCORE=0.8
# NORMALIZE_SANITY_GUARD=1
# NORMALIZE_MIN_CONTAINMENT=0.3
# ROUTER_SOFT_FILTER=1
# ROUTER_SOURCE_QUOTA=4
# ROUTER_FILTER_RANK_BONUS=12
# ENABLE_DENSE_ORIGINAL_QUERY=1
