# =============================================================================
# config/runtime.env.example — profile VẬN HÀNH (dùng hằng ngày: CLI + GUI)
#
# Bất biến của profile này: KHÔNG bật bất kỳ cờ thí nghiệm nào. Mọi lever của vòng
# lặp đo (T3/T4/T5, rescue, reranker, header, dense-raw) đều ghi 0 tường minh để
# người đọc thấy chúng đã được xét chứ không phải bị bỏ quên.
#
# Cách dùng (xem config/README.md): copy .env.example thành .env, rồi chép các dòng
# dưới đây vào CUỐI .env (python-dotenv: dòng sau ghi đè dòng trước). KHÔNG đặt
# GEMINI_API_KEY thật vào file này — đây là file mẫu được commit.
# =============================================================================

# --- Sinh câu trả lời: Gemini + cache + fallback Qwen ---
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TEMPERATURE=0.0
GEMINI_MAX_TOKENS=4096
GENERATION_CACHE=1
QWEN_FALLBACK=1

# --- Ollama (Local SLM / chuẩn hoá / phân loại) ---
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5:1.5b-instruct
OLLAMA_TIMEOUT=90

# --- Generator: Gemini (0), không dùng Qwen thay thế toàn phần ---
USE_QWEN_GENERATOR=0

# --- Truy xuất ---
ENABLE_HYBRID_SEARCH=1
BM25_WEIGHT=0.5
CHROMA_WEIGHT=0.5
ENABLE_QUERY_EXPANSION=1
RAG_TOP_K=6

# --- Phân loại câu hỏi: TẮT ở profile vận hành (bật là lever, xem experiment) ---
ENABLE_CLASSIFIER=0

# --- Vector DB / embedding ---
EMBEDDING_MODEL=BAAI/bge-m3
CHROMA_PERSIST_DIR=./chroma_db

# --- OCR (loader) ---
OCR_ENABLED=1
OCR_DPI=200
OCR_MIN_CHARS_PER_PAGE=50
OCR_CACHE_DIR=./.cache/ocr/rapidocr

# --- Cờ thí nghiệm: GHIM TẮT (không sửa trong profile runtime) ---
ENABLE_ANSWER_GUARD=0
ENABLE_DECOUPLED_REFUSAL=0
ENABLE_EVIDENCE_SELECTION=0
ENABLE_RERANKER=0
RERANKER_KEEP_CANDIDATES=0
RERANKER_FALLBACK=0
ENABLE_CONTEXTUAL_HEADER=0
ENABLE_ANSWER_RESCUE=0
NORMALIZE_SANITY_GUARD=0
ROUTER_SOFT_FILTER=0
ENABLE_DENSE_ORIGINAL_QUERY=0
LEARN_AUTO_APPLY=0
