# =============================================================================
# config/offline.env.example — profile CHỈ-QWEN/OLLAMA (không gọi mây)
#
# Dùng khi không có mạng, hết quota Gemini, hoặc cần tái lập 100% offline.
# Khác profile runtime ở đúng ba điểm:
#   1. USE_QWEN_GENERATOR=1  (Qwen local sinh câu trả lời)
#   2. không khai báo GEMINI_* (không có API nào được gọi)
#   3. câu trả lời Qwen KHÔNG được cache vào .generation_cache/ (xem src/generator.py)
#
# Yêu cầu trước khi chạy: Ollama đang chạy và đã pull OLLAMA_MODEL.
# Các cờ thí nghiệm vẫn GHIM TẮT như profile runtime.
# =============================================================================

# --- Ollama (bắt buộc) ---
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5:1.5b-instruct
OLLAMA_TIMEOUT=90

# --- Generator: Qwen local ---
USE_QWEN_GENERATOR=1

# --- Truy xuất ---
ENABLE_HYBRID_SEARCH=1
BM25_WEIGHT=0.5
CHROMA_WEIGHT=0.5
ENABLE_QUERY_EXPANSION=1
RAG_TOP_K=6

# --- Phân loại câu hỏi ---
ENABLE_CLASSIFIER=0

# --- Vector DB / embedding ---
EMBEDDING_MODEL=BAAI/bge-m3
CHROMA_PERSIST_DIR=./chroma_db

# --- OCR (loader) ---
OCR_ENABLED=1
OCR_DPI=200
OCR_MIN_CHARS_PER_PAGE=50
OCR_CACHE_DIR=./.cache/ocr/rapidocr

# --- Cờ thí nghiệm: GHIM TẮT ---
ENABLE_ANSWER_GUARD=0
ENABLE_DECOUPLED_REFUSAL=0
ENABLE_EVIDENCE_SELECTION=0
ENABLE_RERANKER=0
RERANKER_KEEP_CANDIDATES=0
RERANKER_FALLBACK=0
ENABLE_CONTEXTUAL_HEADER=0
ENABLE_ANSWER_RESCUE=0
NORMALIZE_SANITY_GUARD=0
ROUTER_SOFT_FILTER=0
ENABLE_DENSE_ORIGINAL_QUERY=0
