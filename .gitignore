# ===== Secrets / cấu hình cá nhân (KHÔNG push) =====
.env
.env.*
!.env.example
*.key
*.pem

# ===== Môi trường ảo Python =====
venv/
.venv/
env/
ENV/

# ===== Cache / dữ liệu tự sinh (xóa được, tái tạo lại được) =====
.generation_cache/
.cache/
chroma_db/
__pycache__/
*.py[cod]
*$py.class
.ipynb_checkpoints/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ===== Log / file tạm =====
*.log
*.tmp
*.bak
.DS_Store
Thumbs.db
desktop.ini

# ===== Thư mục logs/ — nơi duy nhất chứa log tự sinh khi chạy =====
# benchmark/ và export/ là log xóa được (chạy lại là có) → ignore.
# learning/ và feedback/ là dữ liệu lịch sử (log học, phản hồi người dùng)
# → được track git, KHÔNG xóa. Xem logs/README.md.
logs/*
!logs/README.md
!logs/learning/
!logs/feedback/

# ===== Cache tạm do công cụ Python/VS Code tự sinh =====
Python/_cache/

# ===== File lock tạm của MS Word/Excel/PowerPoint =====
~$*



# ===== B3 (26-10): artifact lớn giữ ngoài git — xem ARTIFACT_MANIFEST.json ở gốc =====
# models/ chỉ còn artifact + README; mã train/eval đã dời sang tools/train/.
# classifier_baseline*/ và retrieval_baseline/ chưa thuộc phạm vi B3 (chờ PA-33 đầy đủ).
models/*adapter*/
models/qwen25_05b_sft_smoke/

# ChromaDB / cache OCR: mọi biến thể (_vie, _headers_old, …)
# Bản giữ tương thích ngược: máy còn `.ocr_cache*` từ layout cũ (cache nay ở `.cache/ocr/`).
chroma_db*/
.ocr_cache*/

# outputs/: file mới mặc định KHÔNG stage; file đã track giữ nguyên trong git.
# Chốt một kết quả mới để công bố thì `git add -f outputs/<file>` rồi chạy lại manifest.
outputs/*
