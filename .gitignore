# ===== Secrets / cấu hình cá nhân (KHÔNG push) =====
.env
.env.*
!.env.example
*.key
*.pem

# ===== Môi trường ảo Python =====
venv/
.venv/
env/
ENV/

# ===== Cache / dữ liệu tự sinh (xóa được, tái tạo lại được) =====
.generation_cache/
.ocr_cache/
chroma_db/
__pycache__/
*.py[cod]
*$py.class
.ipynb_checkpoints/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ===== Log / file tạm =====
*.log
*.tmp
*.bak
.DS_Store
Thumbs.db
desktop.ini

# ===== Thư mục logs/ — nơi duy nhất chứa log tự sinh khi chạy =====
# benchmark/ và export/ là log xóa được (chạy lại là có) → ignore.
# learning/ và feedback/ là dữ liệu lịch sử (log học, phản hồi người dùng)
# → được track git, KHÔNG xóa. Xem logs/README.md.
logs/*
!logs/README.md
!logs/learning/
!logs/feedback/

# ===== Cache tạm do công cụ Python/VS Code tự sinh =====
Python/_cache/

# ===== File lock tạm của MS Word/Excel/PowerPoint =====
~$*

