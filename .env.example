# =============================================================================
# Mẫu biến môi trường. Sao chép thành `.env` rồi điền giá trị thật.
#
# Từ 26-10 (dọn repo B4): các key của 9 module đã chuyển (retrieval, loader, vector_db,
# local_slm, classifier, chunking, contextual_header, evidence_selection, refusal_policy)
# được đọc qua MỘT điểm duy nhất — `src/core/config.py`, danh sách `TRACKED_ENV`. Giá trị mặc
# định trong code là nguồn sự thật; file này chỉ để đổi khi cần.
# Các module đóng băng/trọng tài (generator, pipeline, query_normalizer, router,
# answer_guard, evaluation) vẫn đọc env trực tiếp — việc gom nốt nằm ở PA-44.
#
# Cờ/ngưỡng của vòng lặp đo (ENABLE_*, EV_*, DEC_*, RERANKER_*, ROUTER_*, …) KHÔNG khai
# báo ở đây: mặc định TẮT trong code và được đăng ký trong `data/loop/README.md`.
# Khối "CẤU HÌNH KHUYẾN NGHỊ (r23)" ở cuối tệp là NGOẠI LỆ có kiểm soát: khuyến nghị được
# ghi dưới dạng DÒNG CHÚ THÍCH (`# TEN_CO=gia_tri`), nên chép nguyên tệp này thành `.env`
# vẫn KHÔNG bật cờ nào — phải bỏ dấu `#` mới bật. Đó là luật của `tools/diag/env_flag_audit.py`
# (một cờ khai báo BẬT trong tệp mẫu bị xếp LOI_KHAI_BAO) và cũng là điều test
# `test_dotenv_example_khong_bat_cua_lever_nao` ghim.
# =============================================================================

# Google Gemini API - backend sinh chữ
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
GEMINI_JUDGE_MODEL=               # (tùy chọn, chỉ src/assessment/evaluation.py dùng) model giám khảo Faithfulness;
                                  # để trống = dùng chung GEMINI_MODEL. Free tier Gemini giới hạn quota
                                  # THEO TỪNG MODEL (~5 request/phút, ~20/ngày), nên đặt model khác
                                  # (vd gemini-3.5-flash-lite) để hai tầng không giành ngân sách của nhau
GEMINI_TEMPERATURE=0.0           # 0.0 = trả lời tất định, phù hợp tra cứu pháp lý
GEMINI_MAX_TOKENS=4096           # gemini-2.5-flash trừ token "thinking" vào cùng ngân sách này;
                                 # đặt quá nhỏ (vd 1024) sẽ làm câu trả lời bị cắt giữa chừng

# Tối ưu quota & chống sập khi demo (src/generator.py) — mặc định đã bật, chỉ khai báo khi muốn tắt
GENERATION_CACHE=1               # 1 = cache câu trả lời Gemini vào ./.generation_cache/ (SHA-1 theo
                                 # model+temperature+prompt); câu hỏi lặp lại/không tốn quota. Xóa
                                 # thư mục này để ép sinh lại. 0 = luôn gọi API (đo latency thật)
QWEN_FALLBACK=1                  # 1 = Gemini hết quota (429)/sự cố thì tổng hợp câu trả lời thay thế
                                 # bằng Local Qwen kèm nhãn cảnh báo; câu fallback KHÔNG được cache.
                                 # 0 = văng lỗi như cũ (main.py vẫn bắt, không chết chương trình)
GENERATION_CACHE_DIR=            # (tùy chọn) thư mục cache, mặc định ./.generation_cache

# Ollama - Local SLM (Qwen)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5:1.5b-instruct
OLLAMA_TIMEOUT=90                # giây; hết thời gian thì main.py tự dùng câu hỏi gốc
USE_QWEN_GENERATOR=0             # 1 = dùng Local Qwen làm Generator sinh câu trả lời trong evaluation (offline 100%, không tốn token Gemini)

# Traverse/retrieval tuning (pipeline.py / vector_db.py)
ENABLE_HYBRID_SEARCH=1            # 1 = bật hybrid search (vector + BM25), 0 = chỉ vector
BM25_WEIGHT=0.5                 # trọng số BM25 trong ensemble (0.0-1.0)
CHROMA_WEIGHT=0.5               # trọng số ChromaDB trong ensemble (0.0-1.0)
ENABLE_QUERY_EXPANSION=1        # 1 = bật expansion 3 tầng cho truy vấn

# Tầng phân loại câu hỏi + router truy xuất (đang xây — chưa có tác dụng cho đến giai đoạn 3)
ENABLE_CLASSIFIER=0             # 1 = phân loại câu hỏi (2 nhãn) + truy xuất theo lớp
CLASSIFIER_MODEL=               # trống = dùng chung OLLAMA_MODEL
CLASSIFIER_TIMEOUT=20           # giây — timeout gọi Ollama cho tầng phân loại

# Vector DB / Embedding
EMBEDDING_MODEL=BAAI/bge-m3
# Đường dẫn tương đối được hiểu theo GỐC DỰ ÁN (src/core/paths.py), không theo thư mục
# đang đứng — chạy từ root, IDE hay thư mục khác đều trỏ cùng một index.
CHROMA_PERSIST_DIR=./chroma_db

# (Tùy chọn) đổi gốc các thư mục dữ liệu; để trống = mặc định trong repo.
# Tương đối → theo gốc dự án; tuyệt đối → giữ nguyên.
RAG_DATA_DIR=
RAG_CORPUS_DIR=
RAG_EVALUATION_DIR=
RAG_LOGS_DIR=
RAG_OUTPUTS_DIR=
RAG_CACHE_DIR=

# Suy luận (main.py/router) — mặc định vận hành: 6 (REVIEW §3); flag -k ghi đè
RAG_TOP_K=6                      # số chunk ngữ cảnh truy xuất mỗi lượt hỏi

# OCR cho PDF scan ảnh (loader.py) — tất cả đều có giá trị mặc định, chỉ khai báo khi muốn đổi
OCR_ENABLED=1                  # 0 = tắt OCR (file scan sẽ bị bỏ qua kèm cảnh báo)
OCR_DPI=200                    # độ phân giải render trang; 200 đủ chất lượng, 300 chậm hơn ~15%
OCR_MIN_CHARS_PER_PAGE=50      # trang có ít ký tự hơn ngưỡng này thì coi là scan và đưa sang OCR
OCR_CACHE_DIR=./.cache/ocr/rapidocr     # cache kết quả OCR để scripts/learn.py rebuild không phải OCR lại

# =============================================================================
# CẤU HÌNH KHUYẾN NGHỊ (r23, 29-10) — cấu hình khuyến nghị:
#     ENABLE_DENSE_ORIGINAL_QUERY=1  và  ENABLE_ANSWER_GUARD=1
#
# Hai cờ này là cặp đã đo trong r23 (29-10) trên 300 id MỚI: dense truy vấn NGUYÊN VĂN + guard
# can thiệp câu bịa ⇒ PASS_CORRECT +21 (p=0,0046, McNemar), FAIL_FABRICATED 1/1, HALLUCINATED
# 0/0, CI cụm [0,0033; 0,16] ⇒ XÁC NHẬN theo luật đăng ký trước. Đây là KHUYẾN NGHỊ của người
# vận hành, KHÔNG phải mặc định của mã: trong code cả hai vẫn mặc định TẮT ("0"), nên máy nào
# không khai báo thì hành vi giữ nguyên như cũ.
#
# `ENABLE_RERANKER` GIỮ TẮT: r22 (29-10) đo một-biến trên nền r17-T — gold@6 581→612 (+31,
# p=3,12e-06) nhưng neo HUMAN 77→72 (−6,49%, ngưỡng −5%) ⇒ BỊ BÁC VETO HUMAN (D-37). Khai báo
# "0" dưới đây chỉ để tường minh, không phải để bật.
# =============================================================================
# Bỏ dấu `#` ở hai dòng dưới để bật khuyến nghị (mặc định của mã vẫn là TẮT):
#   ENABLE_DENSE_ORIGINAL_QUERY=1     # nhánh dense dùng câu hỏi nguyên văn (không fold dấu)
#   ENABLE_ANSWER_GUARD=1             # tầng guard chặn câu bịa (answer_guard.py)
#
# GIỮ TẮT — không nên bật: ENABLE_RERANKER=0  (r22 veto neo HUMAN; xem docs/DECISION_LOG.md D-37)
